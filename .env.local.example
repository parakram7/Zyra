# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard → Settings → API). Both values are safe to expose to
# the browser — they are not secret keys.
#
# Without these set, Zyra runs in local demo mode: no shared backend,
# each browser keeps its own copy of the sample data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
