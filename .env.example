# Supabase project settings — from Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used by scripts/seed-demo.mjs and any future admin-only server routes.
# NEVER expose this to the browser / prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: used to build absolute links (public tracking page, WhatsApp deep links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Future integrations (not wired up yet — placeholders only, see src/lib/integrations) ---
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_MAPBOX_TOKEN=
# WHATSAPP_BUSINESS_API_TOKEN=
# PORTER_API_KEY=
